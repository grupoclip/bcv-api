<?xml version="1.0"?>
<ruleset name="bcv-today">
    <description>PSR-12 for the BCV Today PHP client.</description>
    <file>src</file>
    <file>config</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <!-- Long English messages and test expectations read better on one line. -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>
</ruleset>
