# frozen_string_literal: true

require "rake/testtask"

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.test_files = FileList["test/**/*_test.rb"]
  t.warning = true
end

desc "Run the live tests against https://bcv.today (BCV_LIVE=1)"
task :live do
  ENV["BCV_LIVE"] = "1"
  Rake::Task[:test].invoke
end

desc "Run RuboCop"
task :rubocop do
  sh "rubocop"
end

task default: %i[rubocop test]
